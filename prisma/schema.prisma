// Nexus Logistics — Prisma Schema
// International express logistics platform
// PostgreSQL — UTC timestamps — immutable logistics history

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────────────────────

// Canonical internal shipment status — spec §15, §179
enum ShipmentStatus {
  DRAFT
  CREATED
  RECEIVED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  ARRIVED_DESTINATION
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  CUSTOMER
}

// Provenance of a tracking event — spec §155
enum EventSource {
  CARRIER_API
  CARRIER_WEBHOOK
  OPERATOR
  SYSTEM
  IMPORT
}

enum EnvType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum NotificationType {
  SHIPMENT_CREATED
  SHIPMENT_DISPATCHED
  IN_TRANSIT
  ARRIVED_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  WEBHOOK_ERROR
  SYSTEM_ALERT
}

enum DocumentType {
  SHIPPING_LABEL
  COMMERCIAL_INVOICE
  PACKING_LIST
  CUSTOMS_DOCUMENT
  SHIPMENT_DOCUMENT
  PHOTO
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  CONNECTED
  ERROR
}

enum ExceptionType {
  ADDRESS_ISSUE
  CUSTOMS_ISSUE
  DAMAGED_PACKAGE
  DELIVERY_FAILED
  CARRIER_DELAY
  MISSING_INFORMATION
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum LabelFormat {
  A4
  FLEXI_4X6
  THERMAL
}

enum LabelGenerationStatus {
  PENDING
  READY
  FAILED
}

// ────────────────────────────────────────────────────────────────────────────
// ORGANIZATIONS — multi-tenant foundation (spec §101–103, §185)
// ────────────────────────────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  countryCode     String?  @default("CN")
  defaultLanguage String   @default("en")
  defaultCurrency String   @default("USD")
  timezone        String   @default("Asia/Shanghai")
  settingsJson    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users               User[]
  customers           Customer[]
  shipments           Shipment[]
  carriers            Carrier[]
  carrierAccounts     CarrierAccount[]
  webhookEvents       WebhookEvent[]
  apiKeys             ApiKey[]
  apiLogs             ApiLog[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  systemSettings      SystemSetting[]
  exceptions          Exception[]
  quotes              Quote[]
  warehouses          Warehouse[]
  counters            Counter[]
  warehouseReceivings WarehouseReceiving[]

  @@index([slug])
}

// ────────────────────────────────────────────────────────────────────────────
// RBAC — spec §17–18, §48
// ────────────────────────────────────────────────────────────────────────────

model Role {
  id          String       @id @default(cuid())
  code        RoleCode     @unique
  name        String
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "shipments.create"
  name      String
  roles     Role[]
  createdAt DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// USERS & SESSIONS — spec §17, §141–143
// ────────────────────────────────────────────────────────────────────────────

model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id])
  email           String
  name            String
  passwordHash    String
  avatarUrl       String?
  phone           String?
  language        String       @default("en")
  timezone        String       @default("Asia/Shanghai")
  currency        String?      @default("USD")
  emailVerifiedAt DateTime?
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer         Customer?
  shipmentsCreated Shipment[]       @relation("ShipmentCreator")
  sessions         Session[]
  notifications    Notification[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  apiKeys          ApiKey[]
  supportTickets   SupportTicket[]  @relation("TicketReporter")
  resolvedTickets  SupportTicket[]  @relation("TicketResolver")
  comments         SupportComment[]

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ────────────────────────────────────────────────────────────────────────────
// CUSTOMERS — spec §39
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  name           String
  email          String
  phone          String?
  company        String?
  countryCode    String?
  isActive       Boolean      @default(true)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  addresses Address[]
  shipments Shipment[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// ADDRESSES — spec §63
// ────────────────────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  name         String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  province     String?
  postalCode   String?
  countryCode  String
  phone        String?
  email        String?
  createdAt    DateTime @default(now())

  senderShipments    Shipment[] @relation("SenderAddress")
  recipientShipments Shipment[] @relation("RecipientAddress")
  customer           Customer?  @relation(fields: [customerId], references: [id])
  customerId         String?

  @@index([customerId])
  @@index([countryCode])
}

// ────────────────────────────────────────────────────────────────────────────
// PACKAGES — spec §9, §21, §71
// ────────────────────────────────────────────────────────────────────────────

model Package {
  id            String   @id @default(cuid())
  description   String?
  quantity      Int      @default(1)
  weightKg      Decimal  @db.Decimal(10, 3)
  lengthCm      Decimal  @db.Decimal(8, 2)
  widthCm       Decimal  @db.Decimal(8, 2)
  heightCm      Decimal  @db.Decimal(8, 2)
  declaredValue Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  shipments Shipment[]
}

// ────────────────────────────────────────────────────────────────────────────
// CARRIERS — spec §25–27, §132–133
// ────────────────────────────────────────────────────────────────────────────

model Carrier {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  code              String // unique per org, e.g. "demo-cn"
  name              String
  countryCode       String?
  logoUrl           String?
  adapterKey        String // key of adapter in integrations/carriers
  description       String?
  environment       EnvType       @default(DEVELOPMENT)
  status            CarrierStatus @default(INACTIVE)
  apiBaseUrl        String?
  apiKeyEncrypted   String?
  apiSecretEnc      String?
  accountId         String?
  webhookSecret     String?
  requestsPerMinute Int?
  requestsPerDay    Int?
  lastSyncAt        DateTime?
  isDemo            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  accounts       CarrierAccount[]
  services       CarrierService[]
  statusMappings CarrierStatusMapping[]
  shipments      Shipment[]
  webhookEvents  WebhookEvent[]
  quotes         Quote[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model CarrierAccount {
  id              String       @id @default(cuid())
  carrierId       String
  carrier         Carrier      @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  environment     EnvType      @default(DEVELOPMENT)
  apiKeyEncrypted String?
  apiSecretEnc    String?
  accountId       String?
  username        String?
  passwordEnc     String?
  labelType       String?
  isPrimary       Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([carrierId])
}

model CarrierService {
  id                 String   @id @default(cuid())
  carrierId          String
  carrier            Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  method             String? // air, sea, courier, rail, truck
  priority           Boolean  @default(false)
  estDeliveryMinDays Int?
  estDeliveryMaxDays Int?
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())

  shipments Shipment[]

  @@unique([carrierId, code])
}

// Status normalization — spec §16
model CarrierStatusMapping {
  id             String         @id @default(cuid())
  carrierId      String
  carrier        Carrier        @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  externalStatus String
  internalStatus ShipmentStatus
  description    String?
  createdAt      DateTime       @default(now())

  @@unique([carrierId, externalStatus])
  @@index([internalStatus])
}

// ────────────────────────────────────────────────────────────────────────────
// SHIPMENTS — spec §23–24, §134–135, §151–154
// ────────────────────────────────────────────────────────────────────────────

model Shipment {
  id                     String          @id @default(cuid())
  organizationId         String
  organization           Organization    @relation(fields: [organizationId], references: [id])
  shipmentNumber         String          @unique // SHP-2026-000001
  trackingNumber         String?         @unique // real carrier tracking, nullable until provided
  externalShipmentId     String? // carrier's own id for the shipment
  customerOrderId        String?
  reference              String?
  status                 ShipmentStatus  @default(DRAFT)
  createdById            String?
  createdBy              User?           @relation("ShipmentCreator", fields: [createdById], references: [id])
  customerId             String?
  customer               Customer?       @relation(fields: [customerId], references: [id])
  senderAddressId        String?
  senderAddress          Address?        @relation("SenderAddress", fields: [senderAddressId], references: [id])
  recipientAddressId     String?
  recipientAddress       Address?        @relation("RecipientAddress", fields: [recipientAddressId], references: [id])
  packageId              String?
  packageData            Package?        @relation(fields: [packageId], references: [id])
  carrierId              String?
  carrier                Carrier?        @relation(fields: [carrierId], references: [id])
  serviceId              String?
  service                CarrierService? @relation(fields: [serviceId], references: [id])
  shippingMethod         String?
  isPriority             Boolean         @default(false)
  declaredValue          Decimal?        @db.Decimal(12, 2)
  currency               String?         @default("USD")
  insuredValue           Decimal?        @db.Decimal(12, 2)
  estimatedDeliveryStart DateTime?
  estimatedDeliveryEnd   DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  cancelledById          String?
  notes                  String?
  isDemo                 Boolean         @default(false)
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  items            ShipmentItem[]
  events           TrackingEvent[]
  labels           Label[]
  documents        Document[]
  notifications    Notification[]
  exceptions       Exception[]
  tickets          SupportTicket[]
  webhookEvents    WebhookEvent[]
  receivingRecords WarehouseReceiving[]

  @@index([organizationId])
  @@index([trackingNumber])
  @@index([customerId])
  @@index([carrierId])
  @@index([status])
  @@index([createdAt])
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sku         String?
  description String?
  quantity    Int      @default(1)
  unitValue   Decimal? @db.Decimal(12, 2)
  currency    String?
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

// ────────────────────────────────────────────────────────────────────────────
// TRACKING — spec §32, §62, §154–156
// ────────────────────────────────────────────────────────────────────────────

model TrackingEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status          ShipmentStatus
  providerStatus  String? // raw status as sent by carrier
  description     String?
  location        String?
  city            String?
  countryCode     String?
  occurredAt      DateTime       @default(now()) // preserve carrier timestamp
  receivedAt      DateTime       @default(now())
  source          EventSource    @default(CARRIER_API)
  externalEventId String? // idempotency (spec §30)
  eventHash       String? // fallback idempotency hash
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@unique([shipmentId, externalEventId]) // nullable-unique guard
  @@index([shipmentId])
  @@index([status])
  @@index([occurredAt])
}

// ────────────────────────────────────────────────────────────────────────────
// LABELS & DOCUMENTS — spec §34–36, §40, §149–150
// ────────────────────────────────────────────────────────────────────────────

model Label {
  id            String                @id @default(cuid())
  shipmentId    String
  shipment      Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrierId     String?
  format        LabelFormat           @default(A4)
  url           String?
  fileKey       String?
  mimeType      String?
  barcodeValue  String?
  barcodeType   String?
  generatedById String?
  generatedAt   DateTime              @default(now())
  status        LabelGenerationStatus @default(PENDING)

  @@index([shipmentId])
}

model Document {
  id         String       @id @default(cuid())
  shipmentId String?
  shipment   Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  type       DocumentType
  name       String
  fileKey    String
  mimeType   String
  sizeBytes  Int?
  isPublic   Boolean      @default(false)
  uploadById String?
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?

  @@index([shipmentId])
  @@index([type])
}

// ────────────────────────────────────────────────────────────────────────────
// WEBHOOKS — spec §29–31, §97
// ────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  carrierId       String?
  carrier         Carrier?      @relation(fields: [carrierId], references: [id])
  shipmentId      String?
  shipment        Shipment?     @relation(fields: [shipmentId], references: [id])
  externalEventId String?
  payload         Json
  headers         Json?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  status          WebhookStatus @default(PENDING)
  error           String?
  attempts        Int           @default(0)

  @@index([carrierId])
  @@index([shipmentId])
  @@index([status])
  @@index([receivedAt])
  @@index([externalEventId])
}

// ────────────────────────────────────────────────────────────────────────────
// API KEYS & LOGS — spec §45–47
// ────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  customerId     String?
  name           String
  keyPrefix      String // visible portion (first 8 chars)
  keyHash        String       @unique // hashed full key
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  logs ApiLog[]

  @@index([organizationId])
}

model ApiLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  apiKeyId       String?
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id])
  userId         String?
  method         String
  path           String
  statusCode     Int?
  latencyMs      Int?
  ip             String?
  requestJson    Json?
  responseJson   Json?
  createdAt      DateTime     @default(now())

  @@index([apiKeyId])
  @@index([organizationId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS — spec §43, §86
// ────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  shipmentId     String?
  shipment       Shipment?        @relation(fields: [shipmentId], references: [id])
  type           NotificationType
  title          String
  body           String?
  channel        String           @default("IN_APP") // IN_APP | EMAIL | SMS | WHATSAPP
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([readAt])
}

// ────────────────────────────────────────────────────────────────────────────
// AUDIT LOGS — spec §42 (immutable)
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  beforeJson     Json?
  afterJson      Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// SYSTEM SETTINGS — spec §66–67, §144
// ────────────────────────────────────────────────────────────────────────────

model SystemSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

// ────────────────────────────────────────────────────────────────────────────
// EXCEPTIONS — spec §73, §180
// ────────────────────────────────────────────────────────────────────────────

model Exception {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  shipmentId     String?
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id])
  type           ExceptionType
  description    String
  status         ExceptionStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// SUPPORT TICKETS — spec §74, §187
// ────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  customerId     String?
  shipmentId     String?
  shipment       Shipment?      @relation(fields: [shipmentId], references: [id])
  reportedById   String?
  reportedBy     User?          @relation("TicketReporter", fields: [reportedById], references: [id])
  subject        String
  message        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  resolvedById   String?
  resolvedBy     User?          @relation("TicketResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  comments SupportComment[]

  @@index([organizationId])
  @@index([status])
  @@index([shipmentId])
}

model SupportComment {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// ────────────────────────────────────────────────────────────────────────────
// QUOTES (future checkout) — spec §99–100, §182–183
// ────────────────────────────────────────────────────────────────────────────

model Quote {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  carrierId          String?
  carrier            Carrier?     @relation(fields: [carrierId], references: [id])
  originCountry      String
  destCountry        String
  weightKg           Decimal      @db.Decimal(10, 3)
  lengthCm           Decimal?     @db.Decimal(8, 2)
  widthCm            Decimal?     @db.Decimal(8, 2)
  heightCm           Decimal?     @db.Decimal(8, 2)
  serviceCode        String?
  price              Decimal      @db.Decimal(12, 2)
  currency           String       @default("USD")
  estDeliveryMinDays Int?
  estDeliveryMaxDays Int?
  isDemo             Boolean      @default(false)
  createdAt          DateTime     @default(now())

  @@index([organizationId])
  @@index([originCountry, destCountry])
}

// ────────────────────────────────────────────────────────────────────────────
// WAREHOUSE (future module) — spec §70–72
// ────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  addressLine1   String?
  city           String?
  countryCode    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  locations WarehouseLocation[]

  @@unique([organizationId, code])
}

model WarehouseLocation {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  bins        WarehouseBin[]

  @@unique([warehouseId, code])
}

model WarehouseBin {
  id         String            @id @default(cuid())
  locationId String
  location   WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code       String

  @@unique([locationId, code])
}

model WarehouseReceiving {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shipmentId     String
  shipment       Shipment     @relation(fields: [shipmentId], references: [id])
  operatorId     String?
  weightKg       Decimal?     @db.Decimal(10, 3)
  condition      String?
  photoKeys      Json?
  note           String?
  receivedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([shipmentId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────────────────────
// COUNTERS — shipment id sequences (SHP-2026-000001)
// ────────────────────────────────────────────────────────────────────────────

model Counter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g. "shipment-2026"
  value          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}
