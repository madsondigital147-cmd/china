# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_logistics?schema=public"

# ── Auth ──
# 32+ char random secret: `openssl rand -base64 32`
AUTH_SECRET="change-me-in-production-a-random-32-char-secret"
AUTH_SESSION_TTL_DAYS="30"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nexus Global Logistics"
NEXT_PUBLIC_APP_SLOGAN="Global logistics. From China to the world."
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ── Carrier integration (never commit real credentials) ──
CARRIER_API_URL=""
CARRIER_API_KEY=""
CARRIER_API_SECRET=""
WEBHOOK_SECRET="change-me"

# ── Email (future) ──
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@nexuslogistics.example"

# ── Storage (future) ──
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_PRIVATE_BUCKET="private-documents"

# ── Demo / Seed ──
SEED_DEMO_ADMIN_EMAIL="admin@demo.local"
SEED_DEMO_ADMIN_PASSWORD="DemoAdmin!2026"

# ── Cron ──
CRON_SECRET="change-me-in-production"